# =============================================================================
# FairValue Engine — 배포 환경변수 템플릿 (Phase 6-1)
# -----------------------------------------------------------------------------
# 사용법: 이 파일을 .env 로 복사해 값을 채운다.  cp .env.example .env
# ★ .env 는 절대 커밋하지 않는다(.gitignore 로 제외됨). .env.example 만 커밋.
# ★ 파생 주소(DB_URL / ENGINE_BASE_URL / FRONTEND_ORIGIN / NEXT_PUBLIC_API_BASE_URL)는
#    docker-compose.yml 이 아래 값들로 자동 조립하므로 여기서 설정하지 않는다.
# =============================================================================

# ── 공개 주소 ────────────────────────────────────────────────────────────
# 서버 IPv4 의 점(.)을 하이픈(-)으로 바꾼 sslip.io 주소.
#   예) 서버 IP 가 203.0.113.7 이면 →  203-0-113-7.sslip.io
#   프론트 = https://<DOMAIN> , API = https://api.<DOMAIN> (sslip.io 가 api. 도 해석)
# 실도메인 구매 시 이 값만 교체 + DNS A레코드(루트·api) 설정 후 재빌드.
DOMAIN=CHANGE-ME.sslip.io

# ── PostgreSQL ───────────────────────────────────────────────────────────
POSTGRES_DB=fairvalue
POSTGRES_USER=fairvalue
# 강한 비밀번호로 교체(영숫자 20자 이상 권장).
POSTGRES_PASSWORD=CHANGE-ME-strong-db-password

# ── 백엔드(JWT/엔진) ──────────────────────────────────────────────────────
# HS256 서명키 — 최소 32바이트. 아래 명령으로 생성:
#   PowerShell:  -join ((48..57)+(97..102) | Get-Random -Count 64 | % {[char]$_})
#   Linux/Mac :  openssl rand -hex 32
JWT_SECRET=CHANGE-ME-64-hex-chars-min-32-bytes
JWT_EXP_MINUTES=120
# 엔진 모드: real(기본, 실제 계산) | dummy(자리표시). 배포는 real.
ENGINE_MODE=real

# ── 프론트(빌드 시점 인라인) ───────────────────────────────────────────────
# 데모 배너 표시 여부. true 면 상단 "포트폴리오 데모" 안내 배너 노출.
NEXT_PUBLIC_DEMO_BANNER=true
